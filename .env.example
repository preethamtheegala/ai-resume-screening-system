# MongoDB Atlas Connection URI (e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority)
MONGO_URI=

# Optional Database Name (defaults to ai_resume_screening if not specified)
DB_NAME=

# Resend API Key for Email Notifications
RESEND_API_KEY=

# Server Port (default: 5001 for local, dynamic on Render)
PORT=

# Optional Demo / Initial HR Credentials
DEFAULT_HR_EMAIL=
DEFAULT_HR_PASSWORD=
